# ==========================================
# LEGAL EASE ENVIRONMENT CONFIGURATION
# ==========================================

# Your Google Gemini API key
GEMINI_API_KEY=your_api_key_here


# Gemini model
GEMINI_MODEL=gemini-3.8-flash


# ------------------------------------------------
# DEVELOPMENT MODE
# ------------------------------------------------
# true  = no Gemini API required
# false = real Gemini API
#
# Start with true while testing the project.
# ------------------------------------------------

MOCK_AI=true


# FastAPI backend
BACKEND_URL=http://localhost:8000


# Frontend origin allowed by FastAPI
CORS_ORIGINS=http://localhost:8501